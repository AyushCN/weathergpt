# WeatherGPT Offline Environment Variables
# Copy this file to .env and fill in your values

# Database
DB_ROOT_PASSWORD=root
DB_NAME=weathergpt
DB_USER=weathergpt
DB_PASSWORD=weathergpt

# Local LLM (Ollama)
OLLAMA_MODEL=llama3.1:8b
# OLLAMA_MODEL=phi3:mini          # Alternative: smaller, faster
# OLLAMA_MODEL=llama3.1:70b       # Alternative: better quality, needs more RAM

# Groq API (optional - leave empty for fully offline)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Weather APIs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1

# ML Models
MODEL_DIR=./ml/trained_models
TEMPERATURE_MODEL_PATH=temperature_model.pkl
RAIN_MODEL_PATH=rain_model.pkl

# Debug
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost"]