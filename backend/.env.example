# WeatherGPT Environment Variables

# Database
DATABASE_URL=mysql+pymysql://weathergpt:weathergpt@127.0.0.1:3306/weathergpt

# LLM Providers
# Primary: groq (online) or ollama (offline/local)
LLM_PRIMARY_PROVIDER=groq
# Fallback providers (comma-separated): ollama,keyword
LLM_FALLBACK_PROVIDERS=ollama,keyword
# Auto-select best available provider
LLM_AUTO_SELECT=true

# Groq API (Online - requires internet)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (Local LLM - works offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Weather APIs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1

# IMD API (Optional - for Indian weather alerts)
IMD_API_KEY=your_imd_api_key_here

# ML Models
MODEL_DIR=./ml/trained_models
TEMPERATURE_MODEL_PATH=temperature_model.pkl
RAIN_MODEL_PATH=rain_model.pkl

# Scheduler
FETCH_INTERVAL_MINUTES=30

# Debug
DEBUG=true

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost"]

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing
PASSWORD_HASH_ALGORITHM=argon2