# WeatherGPT Environment Variables

# Database
DATABASE_URL=postgresql://weathergpt:weathergpt@127.0.0.1:5433/weathergpt

# Groq API (Get from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Weather APIs
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1

# IMD API (Optional - for Indian weather alerts)
IMD_API_KEY=your_imd_api_key_here

# ML Models
MODEL_DIR=./ml/models
TEMPERATURE_MODEL_PATH=temperature_model.pkl
RAIN_MODEL_PATH=rain_model.pkl

# Scheduler
FETCH_INTERVAL_MINUTES=30

# Debug
DEBUG=true

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing
PASSWORD_HASH_ALGORITHM=argon2